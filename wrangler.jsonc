{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 中文注释：最小可运行的 Worker 入口，后续 OpenNext 构建产物会输出到这里。
  "name": "xprimes-site",
  "main": ".open-next/worker.js",
  // 中文注释：按官方建议使用当天日期，且不低于 2024-09-23。
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xprimes-db",
      "database_id": "TODO_REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "xprimes-papers"
    }
  ]
}
