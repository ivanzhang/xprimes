{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // 中文注释：最小可运行的 Worker 入口，后续 OpenNext 构建产物会输出到这里。
  "name": "xprimes-site",
  "main": ".open-next/worker.js",
  // 中文注释：按官方建议使用当天日期，且不低于 2024-09-23。
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // 中文注释：后续如需扩展，可继续添加 vars、d1_databases、r2_buckets 等绑定。
}
