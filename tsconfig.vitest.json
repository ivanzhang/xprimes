{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "tsBuildInfoFile": ".next/cache/tsconfig.vitest.tsbuildinfo"
  },
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
